# ─────────────────────────────────────────────────────────────
# Sencia Job — .gitignore
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.npm/
.pnpm-store/

# Build output
dist/
dist-ssr/
dist-electron/
/release/
target/
apps/backend-go/bin/
*.local

# Bundled Python runtime for commercial installs (CH-01) - generated by
# scripts/release/pack-python.ps1, never committed (hundreds of MB, per-machine).
resources/python/
.tools/python-cache/

# Bundled Camoufox browser binary for commercial installs (installer
# hardening) - generated by scripts/release/pack-camoufox.ps1, never committed
# (~1 GB uncompressed, per-machine, refetched from daijro/camoufox releases).
resources/camoufox/
.tools/camoufox-cache/

# Bundled toolchains / vendored SDKs (installed per-machine, not committed)
.tools/

# Go
*.test
*.out
coverage.txt

# Python browser worker
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Secrets & local configuration — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
config.json
profile.json

# Local databases / app state
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Private user data (resumes, history). Root-anchored so source files like
# apps/backend-go/internal/server/resume.go stay tracked.
/resume.*
resumes/
history.json

# QA evidence (may contain real third-party resumes/PDFs — never commit;
# UAT/handoff docs assume this folder is ignored)
qa-artifacts/

# Logs & temp
*.log
npm-debug.log*
yarn-error.log*
.eslintcache
*.tmp
tmp/
.cache/

# graphify local machine/cache artifacts. The useful cross-model map files under
# graphify-out/ (graph.json, GRAPH_REPORT.md, wiki/, memory/, reflections/) stay
# versionable for token-efficient handoff.
graphify-out/cache/
graphify-out/converted/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.vocab.txt
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Editors / IDEs
.vscode/
.idea/
.claude/settings.local.json
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Build binaries (built locally via npm run backend:build / release:electron)
*.exe

# Personal identifiers fed to the package privacy guard. Never tracked: the
# whole point is to keep these strings out of the published repository.
scripts/qa/personal-patterns.local.json
